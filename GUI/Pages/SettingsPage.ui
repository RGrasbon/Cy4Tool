  <property name="styleSheet">
   <string notr="true">/* Allgemein */
QFrame[GuiRole=PageTitelFrame] { background: rgb(210, 210, 210); border-radius: 6px;	padding: 6px; }
QFrame[GuiRole=PageTitelFrame] QLabel {  font: bold 10pt; }
QFrame[GuiRole=GroupBox] { background: rgb(230, 230, 230); }

QPushButton[GuiRole=ToolBarButton] { border: 1px solid transparent; border-radius: 3px; padding: 3px; qproperty-iconSize: 24px; }
QPushButton[GuiRole=ToolBarButton]:hover { background: rgb(220, 220, 220); border-color: rgb(220, 220, 220); }
QPushButton[GuiRole=ToolBarButton]:pressed { background: rgb(220, 220, 220); border-color: rgb(110, 110, 110); }
QPushButton[GuiRole=ToolBarButton]:checked { background: rgb(220, 220, 220); border-color: rgb(110, 110, 110); }

/* Spezifisch */
QPushButton#connectViaSocketButton { background: rgb(220, 220, 240); border: 1px solid rgb(120, 120, 160); border-radius: 3px; padding: 3px; qproperty-iconSize: 32px; }
QPushButton#connectViaSocketButton:hover { background: rgb(240, 240, 255); border-color: rgb(140, 140, 160); }
QPushButton#connectViaSocketButton:pressed { background: rgb(250, 250, 255); border-color: rgb(160, 160, 180); }
QPushButton#connectViaSerialButton { background: rgb(220, 220, 240); border: 1px solid rgb(120, 120, 160); border-radius: 3px; padding: 3px; qproperty-iconSize: 32px; }
QPushButton#connectViaSerialButton:hover { background: rgb(240, 240, 255); border-color: rgb(140, 140, 160); }
QPushButton#connectViaSerialButton:pressed { background: rgb(250, 250, 255); border-color: rgb(160, 160, 180); }</string>
