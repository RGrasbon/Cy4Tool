  <property name="styleSheet">
   <string notr="true">/* Allgemein */
QFrame[GuiRole=PageTitelFrame] { background: rgb(210, 210, 210); border-radius: 6px;	padding: 6px; }
QFrame[GuiRole=PageTitelFrame] QLabel {  font: bold 10pt; }
QFrame[GuiRole=GroupBox] { background: rgb(230, 230, 230); }

QPushButton[GuiRole=ToolBarButton] { border: 1px solid transparent; border-radius: 3px; padding: 3px; qproperty-iconSize: 24px; }
QPushButton[GuiRole=ToolBarButton]:hover { background: rgb(220, 220, 220); border-color: rgb(220, 220, 220); }
QPushButton[GuiRole=ToolBarButton]:pressed { background: rgb(220, 220, 220); border-color: rgb(110, 110, 110); }
QPushButton[GuiRole=ToolBarButton]:checked { background: rgb(220, 220, 220); border-color: rgb(110, 110, 110); }

/* Spezifisch */
QPushButton#readButton { background: rgb(220, 255, 220); border: 1px solid rgb(120, 160, 120); border-radius: 3px; padding: 3px; qproperty-iconSize: 32px; }
QPushButton#readButton:disabled { background: rgba(240, 255, 240, 50); }
QPushButton#readButton:hover { background: rgb(240, 255, 240); border-color: rgb(140, 160, 140); }
QPushButton#readButton:pressed { background: rgb(250, 255, 250); border-color: rgb(180, 160, 160); }

QPushButton#writeButton { background: rgb(255, 220, 220); border: 1px solid rgb(160, 120, 120); border-radius: 3px; padding: 3px; qproperty-iconSize: 32px; }
QPushButton#writeButton:disabled { background: rgba(255, 220, 220, 50); }
QPushButton#writeButton:hover { background: rgb(255, 240, 240); border-color: rgb(160, 140, 140); }
QPushButton#writeButton:pressed { background: rgb(255, 250, 250); border-color: rgb(180, 160, 160); }

QHexEdit#hexEdit { border: 0px;}
QLineEdit#locationEdit { min-width: 5em;}
QLineEdit#countEdit { min-width: 3em;}

QPushButton#absoluteLocationButton { border: 1px solid transparent; min-width: 60px; }
QPushButton#absoluteLocationButton:checked { background: rgb(200, 200, 200); }
QPushButton#relativeLocationButton { border: 1px solid transparent; min-width: 60px; }
QPushButton#relativeLocationButton:checked { background: rgb(200, 200, 200); }
</string>
