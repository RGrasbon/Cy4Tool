QFrame[GuiRole=GroupBox] { background: rgb(230, 230, 230); }

QPushButton[GuiRole=ToolBarButton] { border: 1px solid transparent; border-radius: 3px; padding: 3px; qproperty-iconSize: 24px; }
QPushButton[GuiRole=ToolBarButton]:hover { background: rgb(220, 220, 220); border-color: rgb(220, 220, 220); }
QPushButton[GuiRole=ToolBarButton]:pressed { background: rgb(220, 220, 220); border-color: rgb(110, 110, 110); }
QPushButton[GuiRole=ToolBarButton]:checked { background: rgb(220, 220, 220); border-color: rgb(110, 110, 110); }

/* Spezifisch */
QFrame#headerFrame { background: rgb(230, 230, 230); }
QFrame#headerFrame QLabel {  font: bold; }
QFrame#headerFrame QLabel#titleLabelText { font-style: italic; }
#QFrame#searchFrame { color: rgb(210, 210, 210); }
QTableWidget { border: 0px;}
QTableWidget QHeaderView::section:horizontal
{
	background: rgb(230,230, 230);
	color: rgb(12, 12, 12);
	font: bold;
	border: 1px solid transparent;
    padding: 4px 4px 4px 4px;
}
QTableWidget::item:selected { color: rgb(10, 10, 10); background-color: rgb(200, 200, 200); };
